// Cloudflare settings for the Pickard SSOW & SOPs website.
// The only line you need to change is "database_id" below (see README step 4).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickard-ssow",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // The website files in /public. The server code runs first so it can handle /api and /admin.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Database: documents, settings, people and sign-offs.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pickard-ssow",
      "database_id": "PASTE-YOUR-D1-DATABASE-ID-HERE"
    }
  ],

  // Private file storage: licences, insurance certificates and risk assessments.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "pickard-uploads"
    }
  ],

  // Keep the admin settings (ACCESS_TEAM_DOMAIN, ACCESS_AUD) that you set in the Cloudflare dashboard.
  "keep_vars": true,

  "observability": { "enabled": true }
}
