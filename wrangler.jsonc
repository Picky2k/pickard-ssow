// Cloudflare settings for the Pickard SSOW & SOPs website.
// You don't need to change anything here: Cloudflare creates the database automatically the first time it deploys.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickard-ssow",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // The website files in /public. The server code runs first so it can handle /api and /admin.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Database: documents, settings, people, sign-offs and uploaded files.
  // Created automatically on first deploy (no ID needed).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pickard-ssow"
    }
  ],

  // Keep the settings and secrets (such as ADMIN_PASSWORD) that you add in the Cloudflare dashboard.
  "keep_vars": true,

  "observability": { "enabled": true }
}
