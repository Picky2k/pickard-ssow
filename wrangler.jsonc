// Cloudflare settings for the Pickard SSOW & SOPs website.
// Already set up for Pickard's Cloudflare account: no changes needed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickard-ssow",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // Give the site a free https://pickard-ssow.<your-subdomain>.workers.dev address.
  "workers_dev": true,

  // The website files in /public. The server code runs first so it can handle /api and /admin.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Database: documents, settings, people, sign-offs and uploaded files.
  // This is the "pes_ssow" database already created in Pickard's Cloudflare account.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pes_ssow",
      "database_id": "bd40b9ce-a35f-4102-ae03-cbbab2d4808c"
    }
  ],

  // Keep the settings and secrets (such as ADMIN_PASSWORD) that you add in the Cloudflare dashboard.
  "keep_vars": true,

  "observability": { "enabled": true }
}
